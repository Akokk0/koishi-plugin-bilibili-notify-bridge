{
  "name": "koishi-plugin-bilibili-notify-bridge",
  "description": "把这台 koishi 里已经配好的 bot 借给 bilibili-notify 用 —— 它监听 B 站 UP 主的动态 / 直播，渲染成卡片图片推送出去：https://github.com/Akokk0/bilibili-notify",
  "version": "0.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "bilibili"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akokk0/koishi-plugin-bilibili-notify-bridge.git"
  },
  "homepage": "https://github.com/Akokk0/bilibili-notify",
  "engines": {
    "node": ">=18"
  },
  "koishi": {
    "description": {
      "zh": "把这台 koishi 里已经配好的 bot 借给 [bilibili-notify](https://github.com/Akokk0/bilibili-notify) 用 —— 它监听 B 站 UP 主的动态 / 直播，渲染成卡片图片推送出去。"
    },
    "service": {
      "required": [
        "http"
      ]
    }
  },
  "peerDependencies": {
    "@satorijs/element": "^3.2.0",
    "koishi": "^4.18.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  }
}
